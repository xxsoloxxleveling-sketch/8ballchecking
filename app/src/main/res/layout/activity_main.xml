<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- App Header -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_dashboard"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle_dashboard"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/card_background"
                android:backgroundTint="@color/accent_red" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/status_inactive"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Overlay Permission Warning Card -->
        <LinearLayout
            android:id="@+id/layoutPermissionWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/permission_overlay_title"
                android:textColor="@color/secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/permission_overlay_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnGrantOverlay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:text="@string/permission_overlay_grant"
                android:textColor="@color/text_primary"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Main Action Button -->
        <Button
            android:id="@+id/btnToggleOverlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_gradient"
            android:text="@string/btn_start"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <!-- Calibrate Table Bounds Button -->
        <Button
            android:id="@+id/btnCalibrateTable"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_background"
            android:text="Calibrate Table Bounds"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <!-- Configuration Settings Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_config"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Felt Color Preset Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_felt_preset"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerFeltPreset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/card_background"
                android:popupBackground="@color/surface_dark" />

            <!-- Max Cushion Bounces -->
            <TextView
                android:id="@+id/tvBouncesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Max Cushion Bounces: 3"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbBounces"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="4"
                android:progress="3"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary" />

            <!-- Smoothing Alpha -->
            <TextView
                android:id="@+id/tvSmoothingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="EMA Smoothing Factor: \u03B1 = 0.35"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbSmoothing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="35"
                android:progressTint="@color/primary_variant"
                android:thumbTint="@color/primary_variant" />

            <!-- Debug ROI Box Switch -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDebugBounds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_show_debug"
                android:textColor="@color/text_primary"
                app:useMaterialThemeColors="true" />

        </LinearLayout>

        <!-- Technical Capabilities Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Physics &amp; CV Capabilities"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Multi-Bounce Raycasting (Up to 4 bank reflections)\n• 90° Cue Ball Tangent Deflection Path\n• Ghost Ball Aim Center Point (2R Offset)\n• Real-Time Pocket Alignment Scoring\n• Zero-Heap-Allocation 60 FPS Render Pipeline"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="4dp"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
